BOT_TOKENS=isi_token_bot_1,isi_token_bot_2,isi_token_bot_3
STORAGE_CHANNEL_ID=-1001234567890
BASE_URL=https://upload.asepharyana.my.id
DATABASE_URL=postgresql://asephs:***@100.121.180.82:6432/uploader
PORT=4000
NODE_ENV=production
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
# TRUST_PROXY=true  # Uncomment when behind reverse proxy (Caddy, Nginx) for correct client IP detection

# S3-compatible API credentials
# S3_ACCESS_KEY=filedrop-admin
# S3_SECRET_KEY=your-secret-key-here
# S3_DEFAULT_REGION=us-east-1
# S3_VHOST_DOMAINS=upload.asepharyana.my.id,upload.asepharyana.web.id

# Telegram-safe internal chunking for large stored files
# Telegram getFile download limit is 20 MB; guard rejects > 19922944 (19 MB)
# TELEGRAM_CHUNK_SIZE_BYTES=19922944
# COMPRESS_CHUNKED_UPLOADS=true
# CHUNK_COMPRESSION_MIN_SIZE_BYTES=4096

# Web dashboard/API auth. If empty, dashboard remains public.
ADMIN_API_TOKEN=

# Optional: absolute path to the built SPA directory (apps/web/dist). Leave EMPTY
# for a backend-only deploy — the API then serves exactly what it did before the
# dashboard existed. When set, the path must contain index.html or the service
# logs a warning and serves the API without the dashboard.
# deploy.sh sets this to $DIST_DIR/web automatically on a release that ships one.
# WEB_DIST_PATH=/opt/teleuploader/dist/web

# Optional session cookie settings
# SESSION_COOKIE_NAME=tu_session
# SESSION_COOKIE_MAX_AGE_SECONDS=86400