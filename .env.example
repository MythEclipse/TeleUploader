BOT_TOKENS=isi_token_bot_1,isi_token_bot_2,isi_token_bot_3
# BOT_TOKEN is the single-token fallback for BOT_TOKENS. Set one or the other;
# if both are present BOT_TOKENS wins.
# BOT_TOKEN=isi_token_bot_1
# ADDITIONAL_BOT_TOKENS is appended to BOT_TOKENS for pool rotation on a 429.
# Use it instead of editing BOT_TOKENS so a redeploy cannot drop a bot.
# ADDITIONAL_BOT_TOKENS=isi_token_bot_4,isi_token_bot_5
STORAGE_CHANNEL_ID=-1001234567890
BASE_URL=https://upload.asepharyana.my.id
DATABASE_URL=postgresql://asephs:***@100.121.180.82:6432/uploader
PORT=4000
NODE_ENV=production
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
# TRUST_PROXY=true  # Uncomment when behind reverse proxy (Caddy, Nginx) for correct client IP detection

# S3-compatible API credentials
# S3_ACCESS_KEY=filedrop-admin
# S3_SECRET_KEY=your-secret-key-here
# S3_DEFAULT_REGION=us-east-1
# S3_VHOST_DOMAINS=upload.asepharyana.my.id,upload.asepharyana.web.id

# Telegram-safe internal chunking for large stored files
# Telegram getFile download limit is 20 MB; guard rejects > 19922944 (19 MB)
# TELEGRAM_CHUNK_SIZE_BYTES=19922944
# COMPRESS_CHUNKED_UPLOADS=true
# CHUNK_COMPRESSION_MIN_SIZE_BYTES=4096

# ---------------------------------------------------------------------------
# Google sign-in (multi-user dashboard authentication)
#
# THIS IS HOW PEOPLE LOG IN. There is no token login form any more: a visitor
# clicks "Sign in with Google", the server runs the OAuth authorization-code flow
# with PKCE, verifies the ID token against Google's JWKS, and mints a revocable
# server-side session.
#
# Create the credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID -> Web application) and register the callback URL EXACTLY as
# `${BASE_URL}/api/v1/auth/google/callback`. A mismatch answers
# `redirect_uri_mismatch` at Google before this service ever sees the request, so
# there is nothing in these logs to debug it with.
#
# Leave both unset to disable Google sign-in: the routes then answer 503 and the
# dashboard keeps working for ADMIN_API_TOKEN callers only.
# GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=[REDACTED]
# GOOGLE_REDIRECT_URI=https://upload.asepharyana.my.id/api/v1/auth/google/callback
#   ^ optional; derived from BASE_URL when unset. Set it only when the public URL
#     differs from BASE_URL (a proxy rewriting the origin, for instance).

# Web dashboard/API auth. If empty, dashboard remains public.
#
# NOTE (multi-user): this is NO LONGER a login form field. It is a Bearer
# credential for machine callers -- scripts, CI, `curl`. It resolves to the
# bootstrap organization (slug 'default') and has no user row, so it is
# deliberately single-tenant. Humans sign in with Google above.
ADMIN_API_TOKEN=

# Optional: absolute path to the built SPA directory (apps/web/dist). Leave EMPTY
# for a backend-only deploy — the API then serves exactly what it did before the
# dashboard existed. When set, the path must contain index.html or the service
# logs a warning and serves the API without the dashboard.
# deploy.sh sets this to $DIST_DIR/web automatically on a release that ships one.
# WEB_DIST_PATH=/opt/teleuploader/dist/web

# Optional session cookie settings
# SESSION_COOKIE_NAME=tu_session
# SESSION_COOKIE_MAX_AGE_SECONDS=86400

# Batch upload limits (POST /api/upload with a list of keys)
# BATCH_MAX_ITEMS=100
# BATCH_MAX_SIZE_BYTES=209715200

# Hard ceiling on a single request body. Multipart parts and Docker layer blobs
# stream to a temp file rather than being buffered, but this still bounds the
# stream so a single request cannot exhaust disk.
# MAX_REQUEST_BODY_BYTES=5368709120

# Telegram upload concurrency across the bot pool (see BOT_TOKENS rotation).
# TELEGRAM_BOT_CONCURRENCY=4

# Serve GET Object through an internal redirect instead of streaming the body.
# Useful when a CDN terminates TLS in front of this service. Off by default:
# with it on, the object body is no longer protected by this service's own
# access checks.
# PROXY_S3_GET=false

# The bootstrap admin identity, used ONLY by the shared ADMIN_API_TOKEN path.
#
# With multi-user auth this is no longer the dashboard's tenant scope: a signed-in
# person's organization comes from their own `members` row. This value names the
# owner of the default organization that `pnpm db:seed` creates, and the Bearer
# token resolves through it.
#
# Leave it unset unless you are adopting an existing deployment: seed.ts and this
# variable must agree, or the Bearer path resolves to an org nobody owns.
# BOOTSTRAP_ADMIN_ID=bootstrap-admin

# Sessions are stored in Postgres (`sessions` table) and are revoked on logout.
# There is no Redis dependency: the session store is one indexed row per login, and
# the OAuth `state` ledger is a second small table. Neither needs an external cache,
# so REDIS_URL / BETTER_AUTH_* are gone from this file — that stack (better-auth +
# Redis) was planned as TODO item 6 and was NOT what shipped. Do not set them; they
# are read by nothing.